# Coinalyze — put your exact table URL here
COINALYZE_URL=https://coinalyze.net/?columns=YOUR_COLUMNS&order_by=price_24hour_pchange&order_dir=asc&filter=YOUR_FILTER

# BingX VST
BINGX_API_KEY=
BINGX_SECRET_KEY=
BINGX_ENV=vst
EXECUTION_ENABLED=true
EXECUTION_MODE=vst
BINGX_MARGIN_USDT=1
BINGX_LEVERAGE=10
BINGX_POSITION_MODE=HEDGE

# Telegram
TG_ENABLED=true
TG_BOT_TOKEN=
TG_CHAT_IDS=

# Discovery
MIN_VOLUME_24H=1000000
MIN_OPEN_INTEREST=500000
MAX_CANDIDATES=40

# Market data
KLINE_LIMIT_1H=250
KLINE_LIMIT_15M=250

# Decision
REQUIRE_CVD_CONFIRMATION=true
REQUIRE_15M_TRIGGER=true
MAX_EVENT_AGE_MIN=45
MAX_TRADES_PER_CYCLE=1
SL_ATR_BUFFER=0.50
TARGET_R_MULTIPLE=2.0
